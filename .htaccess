RewriteEngine On
RewriteBase /

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Forzar dominio sin www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Bloquear acceso directo a directorios internos
RewriteRule ^(config|sql|lang|handlers)(/|$) - [F,L]
RewriteRule ^admin/includes(/|$) - [F,L]

# SEO: sitemap dinámico
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Rutas públicas localizadas (EN/FR)
RewriteRule ^(en|fr)/?$          pages/home.php?lang=$1    [L,QSA]
RewriteRule ^(en|fr)/menu/?$     pages/menu.php?lang=$1    [L,QSA]
RewriteRule ^(en|fr)/about/?$    pages/about.php?lang=$1   [L,QSA]
RewriteRule ^(en|fr)/contact/?$  pages/contact.php?lang=$1 [L,QSA]

# Admin (sin i18n)
RewriteRule ^admin/?$            admin/index.php           [L,QSA]

ErrorDocument 404 /pages/error-404.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  # includeSubDomains/preload no se activan por defecto: exigirían HTTPS en
  # todos los subdominios (ej. mail.*) y el "preload" es casi irreversible
  # una vez enviado a las listas de los navegadores. Añadir manualmente
  # cuando se confirme que todos los subdominios sirven HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
</IfModule>

# El Content-Security-Policy se envía dinámicamente desde PHP (con nonce
# por request) en config/bootstrap.php y admin/includes/bootstrap.php,
# no aquí, porque el nonce cambia en cada respuesta.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

Options -Indexes
